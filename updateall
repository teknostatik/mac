#!/bin/sh

#  _   _ ____  ____    _  _____ _____    _    _     _     
# | | | |  _ \|  _ \  / \|_   _| ____|  / \  | |   | |    
# | | | | |_) | | | |/ _ \ | | |  _|   / _ \ | |   | |    
# | |_| |  __/| |_| / ___ \| | | |___ / ___ \| |___| |___ 
#  \___/|_|   |____/_/   \_\_| |_____/_/   \_\_____|_____|
#
# Runs a full local maintenance pass on macOS by applying system updates,
# updating Homebrew formulae, and updating Nix packages when Nix
# is installed.

# macOS updates

sudo softwareupdate -i -a

# App store updates

if ! command -v mas >/dev/null 2>&1; then
	echo "mas not found; installing it with Homebrew."
	brew install mas
fi

if command -v mas >/dev/null 2>&1; then
	mas upgrade
else
	echo "mas is unavailable; skipping Mac App Store updates."
fi

# Homebrew updates

brew update
brew upgrade

# Conditional updates

if command -v nix >/dev/null 2>&1; then
	echo "Nix detected; updating packages and collecting garbage."
	nix-channel --update
	nix-env -u
	nix-collect-garbage -d
else
	echo "Nix not detected; skipping Nix update and garbage collection."
fi

echo "The script has now finished running."
